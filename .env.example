# skitrack environment configuration
# skitrack works with zero configuration — every variable below is optional.

# Directory where the local SQLite database (experiments.db) is stored.
# If unset, skitrack uses the OS-appropriate default app-data folder:
#   Windows: %LOCALAPPDATA%\experiment-tracker
#   macOS:   ~/Library/Application Support/experiment-tracker
#   Linux:   $XDG_DATA_HOME/experiment-tracker (or ~/.local/share/experiment-tracker)
EXPERIMENT_TRACKER_DATA_DIR=
